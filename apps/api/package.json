{
  "name": "@yaropay/api",
  "version": "0.2.0",
  "private": true,
  "description": "YaroPay API: NestJS backend for multi-product payment orchestration",
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "predev": "tsc -p tsconfig.build.json",
    "dev": "concurrently -k -n tsc,api -c gray,cyan \"tsc -p tsconfig.build.json --watch --preserveWatchOutput\" \"node --watch-path=dist --enable-source-maps dist/main.js\"",
    "start": "node --enable-source-maps dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/cli/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=.env src/cli/seed.ts",
    "e2e:serve": "tsc -p tsconfig.build.json && node --input-type=module -e \"import{rmSync}from'node:fs';rmSync(process.env.PGLITE_DIR,{recursive:true,force:true})\" && node dist/cli/seed.js --quiet && ([ -z \"$E2E_SUPER_ADMIN\" ] || node dist/cli/accounts.js grant-super-admin \"$E2E_SUPER_ADMIN\") && node dist/main.js",
    "test:pg": "vitest run --no-file-parallelism"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.16",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "@nestjs/throttler": "6.7.1",
    "@yaropay/core": "*",
    "cookie-parser": "1.4.7",
    "drizzle-orm": "0.45.4",
    "helmet": "8.3.0",
    "nodemailer": "10.6.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@swc/core": "1.16.22",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.7",
    "drizzle-kit": "0.31.11",
    "supertest": "7.3.2",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "unplugin-swc": "2.0.0",
    "vitest": "5.1.0"
  }
}
