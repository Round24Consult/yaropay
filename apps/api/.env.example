# Local development. Copy to apps/api/.env (loaded automatically by npm run dev / start).

# Empty = embedded PGlite database in .data/pglite (no Postgres needed).
# DATABASE_URL=postgres://yaropay:yaropay@localhost:5432/yaropay
PORT=4000
DASHBOARD_URL=http://localhost:3000
# Through the dashboard's proxy, so gateway callbacks work on one origin in development.
YAROPAY_BASE_URL=http://localhost:3000

# Optional in development (a fixed dev key is used and a warning printed). Required in production.
# YAROPAY_ENCRYPTION_KEY=

# Empty = emails are printed to the API log.
# SMTP_URL=smtp://localhost:1025

# Faster password hashing for local work. Ignored in production.
PASSWORD_HASH_COST=fast
