# Used by docker-compose.yml. Copy to .env and fill in.

# Required. 32 random bytes, base64: openssl rand -base64 32
# Encrypts gateway keys and signing secrets at rest. Keep it safe: losing it means re-entering every key.
YAROPAY_ENCRYPTION_KEY=

POSTGRES_PASSWORD=yaropay

# Where people open the dashboard (CORS and links in emails).
DASHBOARD_URL=http://localhost:3000
# Public URL gateways and customers reach (callbacks, gateway webhooks). Editable later in Settings.
YAROPAY_BASE_URL=http://localhost:3000

# Real email: smtp://user:pass@smtp.example.com:587. The default sends to the bundled Mailpit.
SMTP_URL=smtp://mailpit:1025
MAIL_FROM=YaroPay <no-reply@yaropay.local>

# auto = Secure cookies in production. Set false only for plain-http testing on a LAN address.
COOKIE_SECURE=auto
# Allow forwarding events to private addresses (products on the same network).
WEBHOOK_ALLOW_PRIVATE=false
